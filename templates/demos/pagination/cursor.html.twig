{% extends 'demos/pagination/demo.html.twig' %}

{% block demo_container %}

    <div class="PaginationDemoShell max-w-[1140px] mx-auto mb-12">
        <twig:Browser
            class="PaginationDemoBrowser CursorPaginationBrowser shadow-blur shadow-blur--rainbow w-full"
            frameClass="aspect-[5/3]"
        >
            {% set current_items = pagination.items %}
            {% set current_ids = current_items|map(item => item.id) %}
            {% set current_boundary = cursorPayload ? cursorPayload.values|first : null %}
            {% set next_boundary = nextCursorPayload ? nextCursorPayload.values|first : null %}
            <div class="CursorPagination">
                <div class="CursorPagination_main">
                    <header class="CursorPagination_header">
                        <div>
                            <p class="CursorPagination_eyebrow">20 ordered values <span aria-hidden="true">&middot;</span> 5 values per slice</p>
                            <h2>The window moves. The grid does not.</h2>
                        </div>
                    </header>

                    <section class="CursorPagination_window" aria-label="Twenty ordered values with the current cursor slice highlighted">
                        <ol class="CursorPagination_grid">
                            {% for number in range(20, 1) %}
                                <li class="CursorPagination_dot{{ number in current_ids ? ' is-active' }}{{ number == next_boundary ? ' is-boundary' }}{{ withDeletedItem and number == 18 ? ' is-deleted' }}">
                                    <span>{{ number }}</span>
                                </li>
                            {% endfor %}
                        </ol>

                        <ul class="CursorPagination_legend" aria-label="Grid legend">
                            <li><span class="is-active" aria-hidden="true"></span>Visible now</li>
                            <li><span class="is-boundary" aria-hidden="true"></span>Next boundary</li>
                            {% if withDeletedItem %}<li><span class="is-deleted" aria-hidden="true"></span>Deleted</li>{% endif %}
                        </ul>
                    </section>

                    <footer class="CursorPagination_footer">
                        {{ ux_pagination(pagination, show_info: false) }}
                    </footer>
                </div>

                <aside class="CursorPagination_inspector">
                    <header>
                        <p class="CursorPagination_eyebrow">Cursor state</p>
                        <h3>
                            {{ not cursorPayload ? 'Start with the first five' : (withDeletedItem ? 'The slice stays put' : 'Resume after ' ~ current_boundary) }}
                        </h3>
                    </header>

                    <dl>
                        <div>
                            <dt>Incoming cursor</dt>
                            <dd>{{ current_boundary ? 'after ' ~ current_boundary : 'none' }}</dd>
                        </div>
                        <div>
                            <dt>Visible slice</dt>
                            <dd>{{ (current_items|first).id }} to {{ (current_items|last).id }}</dd>
                        </div>
                        <div>
                            <dt>Next cursor</dt>
                            <dd>{{ next_boundary ? 'after ' ~ next_boundary : 'none' }}</dd>
                        </div>
                        <div>
                            <dt>Count query</dt>
                            <dd>none</dd>
                        </div>
                    </dl>

                    <p class="CursorPagination_note">
                        {% if not cursorPayload %}
                            Next records the value 16. It does not calculate page 2.
                        {% elseif withDeletedItem %}
                            Value 18 disappeared before the boundary. The active slice remains {{ (current_items|first).id }} to {{ (current_items|last).id }}.
                        {% else %}
                            This request starts after {{ current_boundary }}. Previous uses the same stable order in reverse.
                        {% endif %}
                    </p>

                    <div class="CursorPagination_change">
                        {% if not cursorPayload %}
                            <p>Use Next to move the highlighted window.</p>
                        {% elseif withDeletedItem %}
                            <a href="{{ path('app_demo_pagination_cursor', app.request.query.all|filter((value, key) => key != 'deleted')) }}">Restore value 18</a>
                        {% else %}
                            <p>Now remove a value before the captured boundary.</p>
                            <a href="{{ path('app_demo_pagination_cursor', app.request.query.all|merge({deleted: 1})) }}">Delete value 18</a>
                        {% endif %}
                    </div>
                </aside>
            </div>
        </twig:Browser>
    </div>

    <section class="py-12" style="padding-top: 6rem;">
        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
            <twig:Code:CodeWithExplanationRow
                filename="src/Controller/Demo/CursorPaginationDemoController.php"
                :lineStart="32"
                :lineEnd="39"
                reversed
                sticky
            >
## Define one stable order

Pass the original source, define a deterministic order, and choose the slice
size. `paginate()` reads the incoming `?cursor` automatically.

For an array source, `context()` gives this logical feed a stable identity. The
cursor token is signed and tied to that context and order.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="templates/demos/pagination/cursor.html.twig"
                targetTwigBlock="cursor_documentation_example"
                :stripExcessHtml="true"
                sticky
            >
## Render the slice and its links

The result stays iterable. Render it like any other collection, then pass the
same object to `ux_pagination()` for ordinary Previous and Next links.

Each link carries an opaque cursor. Your Twig template never decodes it or
reconstructs the boundary.
            </twig:Code:CodeWithExplanationRow>
        </div>
    </section>

{% endblock %}

{% block cursor_documentation_example %}
{% for item in pagination %}
    <article>Item {{ item.id }}</article>
{% endfor %}

{{ ux_pagination(pagination) }}
{% endblock %}
