{% extends 'base.html.twig' %}

{% set meta = {
    title: 'Pagination demos',
    description: 'Explore numbered, cursor, themed, and reactive pagination with Symfony UX Pagination.',
    canonical: url('app_demo_pagination'),
} %}

{% block content %}
    <section class="bg-subtle py-16 md:py-24">
        <div class="mx-auto max-w-[1400px] px-6 md:px-12">
            <p class="eyebrows mb-4 text-center"><a href="{{ path('app_demos') }}">Demos</a> / Pagination</p>
            <h1 class="text-center">Pagination demos</h1>
            <p class="mx-auto mt-5 max-w-2xl text-center text-lg leading-8 text-body-text/75">
                Explore numbered pages, stable cursors, Twig themes, and reactive navigation.
            </p>
        </div>
    </section>

    <section class="mx-auto max-w-[1400px] px-6 py-16 md:px-12 md:py-24">
        {{ include('demos/pagination/_cards.html.twig') }}
    </section>
{% endblock %}
