{% extends 'demos/live_demo.html.twig' %}

{% block demo_container %}

    <div class="PaginationDemoShell max-w-[1140px] mx-auto mb-12">
        <twig:Browser
            class="PaginationDemoBrowser CursorPaginationBrowser shadow-blur shadow-blur--rainbow w-full"
            syncUrl
            :showOrigin="false"
        >
            <div class="CursorPagination">
                <div class="CursorPagination_main">
                    <header class="CursorPagination_header">
                        <div>
                            <p class="CursorPagination_eyebrow">UX release feed</p>
                            <h2>Newest first</h2>
                        </div>
                        <p class="CursorPagination_cursor">
                            <span aria-hidden="true"></span>
                            {{ cursorPayload ? 'Resume from a boundary' : 'Start of feed' }}
                        </p>
                    </header>

                    <ol class="CursorPagination_feed">
                        {% for release in pagination %}
                            <li class="{{ release.id == 12 ? 'is-new' }}">
                                <span class="CursorPagination_version">3.{{ release.id }}</span>
                                <span class="CursorPagination_release">
                                    <strong>{{ release.name }}</strong>
                                    <small>{{ release.summary }}</small>
                                </span>
                                <span class="CursorPagination_order">{{ '%02d'|format(loop.index) }}</span>
                            </li>
                        {% endfor %}
                    </ol>

                    <footer class="CursorPagination_footer">
                        <p><strong>4</strong> releases per request</p>
                        {{ ux_pagination(pagination, show_info: false) }}
                    </footer>
                </div>

                <aside class="CursorPagination_inspector">
                    <header>
                        <p class="CursorPagination_eyebrow">Cursor inspector</p>
                        <h3>{{ cursorPayload ? 'This request resumes here' : 'No cursor yet' }}</h3>
                    </header>

                    {% if cursorPayload %}
                        <dl>
                            <div>
                                <dt>Direction</dt>
                                <dd>{{ cursorPayload.direction }}</dd>
                            </div>
                            <div>
                                <dt>Boundary</dt>
                                <dd>id {{ cursorPayload.values|first }}</dd>
                            </div>
                            <div>
                                <dt>Order</dt>
                                <dd>{{ cursorPayload.order }}</dd>
                            </div>
                            <div>
                                <dt>Context</dt>
                                <dd>{{ cursorPayload.context }}</dd>
                            </div>
                            <div>
                                <dt>Signature</dt>
                                <dd>{{ cursorPayload.signature }}</dd>
                            </div>
                        </dl>
                        <p class="CursorPagination_note">Readable, signed, and bound to this query. Changing any value invalidates it.</p>
                    {% else %}
                        <div class="CursorPagination_emptyCursor">
                            <span>1</span>
                            <p>Use <strong>Next</strong>. The link will carry the last ordered value of this slice.</p>
                        </div>
                    {% endif %}

                    <div class="CursorPagination_change">
                        {% if withNewRelease %}
                            <p><span aria-hidden="true"></span> Release 3.12 was inserted at the top.</p>
                            <a href="{{ path('app_demo_live_component_cursor_pagination', app.request.query.all|filter((value, key) => key != 'published')) }}">Reset feed</a>
                        {% else %}
                            <p><span aria-hidden="true"></span> Simulate data changing between requests.</p>
                            <a href="{{ path('app_demo_live_component_cursor_pagination', app.request.query.all|merge({published: 1})) }}">Publish a release</a>
                        {% endif %}
                    </div>
                </aside>
            </div>
        </twig:Browser>
    </div>

    <section class="py-12" style="padding-top: 6rem;">
        <div class="max-w-[1400px] mx-auto">
            <twig:Code:CodeWithExplanationRow
                filename="src/Controller/Demo/LiveDemoController.php"
                :lineStart="122"
                :lineEnd="129"
                reversed
                sticky
            >
## Resume after a value, not a position

The first request has no cursor. The next link contains the ordered value at the
end of the slice - here, an `id` - plus its direction, order, and context.

On the next request, the adapter asks for rows after that value. A newly inserted
row can change the beginning without shifting this boundary. The token is signed,
so changing its value or reusing it with another query produces a 400 response.
            </twig:Code:CodeWithExplanationRow>
        </div>
    </section>

{% endblock %}
