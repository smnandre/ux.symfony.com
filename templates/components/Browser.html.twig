{% props
    url = 'ux.symfony.com',
    syncUrl = false,
    showOrigin = true,
    showPath = true,
    showQuery = true,
%}

<div
    {{ attributes.defaults({
        class: 'browser',
        'data-controller': 'browser',
        'data-browser-sync-url-value': syncUrl ? 'true' : 'false',
        'data-browser-url-value': url,
        'data-browser-show-origin-value': showOrigin ? 'true' : 'false',
        'data-browser-show-path-value': showPath ? 'true' : 'false',
        'data-browser-show-query-value': showQuery ? 'true' : 'false',
        'data-action': 'browser:loading-start->browser#startLoading browser:loading-end->browser#stopLoading browser:url-sync->browser#syncUrl',
    }) }}
>
    <div class="browser_shell">
        <header class="browser_header">
            <div class="browser_controls" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="browser_url">
                <span class="browser_url-icon" aria-hidden="true"><twig:ux:icon name="lock" /></span>
                <span class="browser_url-value">
                    <span class="browser_url-origin" data-browser-target="origin">{{ url }}</span>
                    <span class="browser_url-path" data-browser-target="path" hidden></span>
                    <span class="browser_url-query" data-browser-target="query" hidden></span>
                </span>
                <span class="browser_url-icon" aria-hidden="true"><twig:ux:icon name="refresh" /></span>
            </div>

            <div class="browser_actions"></div>
        </header>

        <div class="browser_viewport" data-browser-target="viewport">
            {% block content %}{% endblock %}
        </div>
    </div>
</div>
