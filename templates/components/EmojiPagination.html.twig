<div{{ attributes }} class="p-6">
    <div class="flex items-center justify-end mb-4">
        <label class="text-sm text-gray-500 dark:text-gray-400">
            Per page
            <select
                data-model="perPage"
                class="ml-2 rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 px-2 py-1 text-sm"
            >
                <option>12</option>
                <option>24</option>
                <option>48</option>
            </select>
        </label>
    </div>

    <div
        class="grid grid-cols-6 sm:grid-cols-8 gap-3 text-3xl mb-8 min-h-44 content-start transition-opacity"
        data-loading="addClass(opacity-40)"
    >
        {% for emoji in this.pagination %}
            <span class="text-center">{{ emoji }}</span>
        {% endfor %}
    </div>

    {{ ux_pagination(
        this.pagination,
        theme: '@UXPagination/theme/tailwind.html.twig',
        link_attributes: this.paginationLinkAttributes,
    ) }}
</div>
