<div{{ attributes }} class="p-6">
    <div class="grid md:grid-cols-[240px_1fr] gap-8">
        <aside class="flex flex-col gap-5 text-sm">
            <label class="flex flex-col gap-1">
                <span class="eyebrows">Theme</span>
                <select data-model="theme" class="rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 px-2 py-1">
                    <option value="default">Default (bundle)</option>
                    <option value="tailwind">Tailwind (bundle)</option>
                    <option value="dots">Dot pager (your app)</option>
                </select>
            </label>

            {% if this.theme == 'default' %}
                <label class="flex items-center justify-between gap-2">
                    <span class="eyebrows">Accent color</span>
                    <input type="color" data-model="accentColor" class="h-8 w-14 rounded border border-gray-300 dark:border-gray-600">
                </label>
            {% endif %}

            <label class="flex flex-col gap-1">
                <span class="eyebrows">Navigation</span>
                <select data-model="mode" class="rounded-md border border-gray-300 dark:border-gray-600 dark:bg-gray-800 px-2 py-1">
                    <option value="sliding">sliding()</option>
                    <option value="fixed">fixed()</option>
                    <option value="full">full()</option>
                </select>
            </label>

            {% if this.mode != 'full' %}
                <label class="flex flex-col gap-1">
                    <span class="eyebrows">Window size: {{ this.size }}</span>
                    <input type="range" min="3" max="9" data-model="size">
                </label>
            {% endif %}

            <label class="flex items-center gap-2">
                <input type="checkbox" data-model="showInfo">
                <span>Show summary</span>
            </label>
        </aside>

        <div class="min-w-0">
            <div
                class="rounded-lg border border-gray-200 dark:border-gray-700 p-6 mb-6 overflow-x-auto transition-opacity"
                data-loading="addClass(opacity-40)"
            >
                {{ ux_pagination(
                    this.pagination,
                    attributes: {style: this.accentStyle},
                    theme: this.themeTemplate,
                    show_info: this.showInfo,
                    link_attributes: this.paginationLinkAttributes,
                ) }}
            </div>

            <details>
                <summary class="cursor-pointer text-sm text-gray-500 dark:text-gray-400">
                    The Twig template behind this theme
                </summary>
                <pre class="mt-3 max-h-96 overflow-auto rounded-lg bg-gray-900 text-gray-100 text-xs p-4"><code>{{ this.themeSource }}</code></pre>
            </details>
        </div>
    </div>
</div>
