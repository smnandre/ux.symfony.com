<div
    class="PackageHeader {{ not (command ?? true) ? 'pb-12' }} pt-12"
    style="background: {{ background ?? (package.gradient ~ ', ' ~ package.color) }}; --color-accent: {{ package.color }};"
>
    <div class="max-w-[1400px] mx-auto px-6 pt-6 md:px-12 md:pt-12 relative">

        <p class="eyebrows text-center text-white mt-12 mb-4" style="opacity: 0.85;">{{ eyebrowText|raw }}</p>

        <h1 class="text-center text-white text-balance text-shadow-lg [&_em]:inline-flex [&_em]:font-normal [&_em]:not-italic [&_em]:-skew-x-16 [&_em]:scale-y-95">{% block title_header %}{{ title|default }}{% endblock %}</h1>

        <div class="flex justify-center">
            <p class="Wysiwyg text-center text-white mt-4 pb-4 w-1/2 text-balance max-xl:w-3/5 max-[734px]:w-4/5">
                {% block sub_content %}{{ subtitle|default }}{% endblock %}
            </p>
        </div>

        {% block header_action_area %}
        <div class="PackageHeaderActions flex flex-wrap items-stretch justify-center gap-4 translate-y-1/2">
            {% if command is not defined or command %}
                <twig:TerminalCommand
                    aria-label="Composer command to install {{ package.humanName }}"
                    class="PackageHeaderCommand"
                    command="{{ package.composerRequireCommand }}"
                    style="--color-accent: {{ package.color }};"
                />
            {% endif %}

            {% block header_primary_action %}{% endblock %}

            {% if package.shouldShowDocsLink %}
                <a
                    href="{{ package.officialDocsUrl }}"
                    class="PackageHeaderAction PackageHeaderAction--docs relative flex items-center justify-center gap-2 border transition-colors"
                >
                    <twig:ux:icon name="book-text" class="Icon size-5" />
                    Read the docs
                </a>
            {% endif %}

            {% block header_actions %}{% endblock %}
        </div>
        {% endblock %}
    </div>
</div>
